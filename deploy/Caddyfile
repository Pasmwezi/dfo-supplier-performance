{
    admin off
}

{$CADDY_SITE_ADDRESS} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    reverse_proxy app:8080 {
        health_uri /ready
        health_interval 30s
        health_timeout 5s
    }

    log {
        output stdout
        format json
    }
}
